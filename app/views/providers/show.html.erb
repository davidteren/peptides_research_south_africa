<% content_for :title, @provider.name %>

<%= render "disclaimer" %>

<article id="provider-detail">
  <h1 id="provider-name" class="text-3xl font-semibold"><%= @provider.name %></h1>
  <p class="mt-2 text-sm text-stone-600">
    <%= t("providers.kind") %>: <%= provider_kind_label(@provider.kind) %>
  </p>
  <%= checked_stamp(@provider.last_reviewed_at, id: "provider-checked") %>

  <% if @provider.kind == "research_storefront" %>
    <p id="provider-research-notice" class="mt-4 border border-stone-200 bg-white p-3 text-sm">
      <%= t("providers.research_notice") %>
    </p>
  <% end %>

  <dl class="mt-6 grid gap-3 text-sm">
    <% if @provider.city.present? %>
      <div>
        <dt class="font-semibold"><%= t("providers.city") %></dt>
        <dd id="provider-city"><%= @provider.city %></dd>
      </div>
    <% end %>
    <div>
      <dt class="font-semibold"><%= t("providers.website") %></dt>
      <dd><%= link_to @provider.website, @provider.website, id: "provider-website", class: "underline" %></dd>
    </div>
    <div>
      <dt class="font-semibold"><%= t("providers.posture") %></dt>
      <dd id="provider-posture"><%= @provider.listing_posture.to_s.humanize %></dd>
    </div>
    <div>
      <dt class="font-semibold"><%= t("providers.prescription") %></dt>
      <dd id="provider-prescription"><%= @provider.prescription_required.to_s.humanize %></dd>
    </div>
  </dl>

  <section class="mt-8">
    <h2 class="font-semibold"><%= t("providers.listings") %></h2>
    <% if @products.empty? %>
      <p id="provider-listings-empty" class="mt-2 text-stone-600"><%= t("providers.listings_empty") %></p>
    <% else %>
      <%= render "products/comparison_table",
            table_id: "provider-comparison",
            row_id_prefix: "provider-listing",
            identity: :compound,
            products: @products %>
    <% end %>
  </section>
</article>
